# ==============================================================================
# Logico Fleet Enterprise - Environment Configuration Template
# ==============================================================================

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logico_fleet
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=local
APP_NAME="Logico Fleet Management System"
APP_URL=http://localhost/Fleet%20management%20%20system/logico-fleet/public

# Regional Operations Settings (Eswatini)
DEFAULT_CURRENCY=SZL
DEFAULT_CURRENCY_SYMBOL=E
HEADQUARTERS_DEPOT="Matsapha Industrial Distribution Centre"
DEFAULT_LATITUDE=-26.4988
DEFAULT_LONGITUDE=31.3807
